From 6685a439e895edad512c17e5987a8de4a972cd45 Mon Sep 17 00:00:00 2001
From: Hyrum Hendrickson <hyrumh.guru@byui.edu>
Date: Wed, 11 Nov 2026 17:49:17 +0000
Subject: [PATCH 1/2] Make nearest_altar test-only to clear the dead_code
 warning

Crows call nearest_altar_beyond (they skip the altar they are perched on),
so the plain nearest_altar wrapper is used only by tests.
---
 src/terrain.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/terrain.rs b/src/terrain.rs
index e324c7d..f9053e1 100644
--- a/src/terrain.rs
+++ b/src/terrain.rs
@@ -85,6 +85,8 @@ pub fn altar_site_ok(seed: i64, landmarks: &Landmarks, x: i32, z: i32) -> bool {
 }
 
 /// The altar nearest to the column (x, z) within `reach` blocks (the ones that can stand: `altar_site_ok`), as its column.
+/// Crows use `nearest_altar_beyond` (they skip the altar they are perched on); this form is for the tests.
+#[cfg(test)]
 pub fn nearest_altar(seed: i64, landmarks: &Landmarks, x: i32, z: i32, reach: f32) -> Option<(i32, i32)> {
     nearest_altar_beyond(seed, landmarks, x, z, 0.0, reach)
 }
-- 
